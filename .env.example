# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below is optional except where noted -
# the defaults are enough to run the app locally with docker compose.
# ---------------------------------------------------------------------------

# ---- Application ----
ENVIRONMENT=development           # development | test | production
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database (required in production) ----
DATABASE_URL=postgresql+asyncpg://docmind:docmind@localhost:5432/docmind
DB_ECHO=false

# ---- Auth ----
# REQUIRED in production. Generate one with:  openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---- Redis ----
# Holds revoked token IDs. Leave empty to use an in-process blocklist, which is
# fine for a single worker but is NOT shared across processes.
REDIS_URL=redis://localhost:6379/0

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# ---- Chunking (character counts) ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ---- Embeddings ----
# hash   - deterministic local embedder, no API key, lexical matching only.
#          Great for getting started and for tests; weak at paraphrases.
# voyage - Voyage AI (Anthropic's recommended embedding partner).
# openai - any OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=voyage-3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Must match the vector column width in the migration (1536). Providers with a
# narrower native width are zero-padded, which leaves cosine similarity intact.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# ---- Answer generation (Claude) ----
# Without a key the API still works: /chat returns the matching passages
# verbatim instead of a written answer.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
LLM_EFFORT=medium                 # low | medium | high | xhigh | max
LLM_THINKING=adaptive             # adaptive (Claude 4.6+) | off
LLM_REFUSAL_FALLBACK=true
LLM_TIMEOUT_SECONDS=120

# ---- Retrieval ----
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
